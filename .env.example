# Resumeee Web SPA Environment Configuration
# Copy this file to .env.local for local development overrides

# Base URL pointing to the Resumeee REST API endpoint (relative or absolute)
VITE_API_BASE_URL=/api/v1

# Development proxy target for local API server
VITE_API_PROXY_TARGET=http://localhost:8080

# Production sourcemaps toggle (false by default for security)
VITE_SOURCEMAP=false

# Run in local single-user Admin Mode (attaches X-User-ID: default when no Bearer token is set)
ADMIN_MODE=true
